{
  "name": "edu-crm-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Education CRM + ERP platform",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:up": "tsx scripts/dev-db.ts up",
    "db:down": "tsx scripts/dev-db.ts down",
    "db:status": "tsx scripts/dev-db.ts status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx scripts/worker.ts",
    "cron": "tsx scripts/cron.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:verify": "tsx scripts/verify-integrity.ts",
    "verify:ledger": "tsx scripts/verify-ledger.ts",
    "bootstrap": "tsx scripts/bootstrap-production.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^0.475.0",
    "next": "16.3.6",
    "next-themes": "^0.4.4",
    "pg": "^8.23.0",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-day-picker": "^9.5.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^17.4.0-beta.15",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.5.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
