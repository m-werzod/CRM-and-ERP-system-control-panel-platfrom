###############################################################################
# Education CRM + ERP — environment
#
# Copy to `.env` and fill in. Every variable is validated at boot by
# src/server/env.ts, so a misconfigured deployment fails immediately with a
# precise message rather than at 2am inside a payment handler.
#
# Placeholder values starting "change-me", "your-" or "xxx" are REJECTED, so the
# examples below must actually be replaced.
#
# Legend:
#   [REQUIRED]  the app will not start without it
#   [OPTIONAL]  has a working default
#   [IF …]      required only when the named driver is selected
###############################################################################


# =============================================================================
# CORE
# =============================================================================

# [REQUIRED] development | test | production
NODE_ENV=development

# [REQUIRED] PostgreSQL connection string.
#
# The default below points at the local cluster `npm run db:up` manages — no
# Docker and no system PostgreSQL needed. For a managed database, paste its
# connection string here (Neon, Supabase, Railway, RDS, …).
#
# In production, append `?sslmode=require` unless you terminate TLS elsewhere.
DATABASE_URL="postgresql://edu_admin:edu_dev_password@127.0.0.1:55432/edu_crm_erp?schema=public"

# [OPTIONAL] Scratch database Prisma diffs migrations against. Needed only by
# `prisma migrate dev`; `migrate deploy` (CI/production) does not use it.
SHADOW_DATABASE_URL="postgresql://edu_admin:edu_dev_password@127.0.0.1:55432/edu_crm_erp_shadow?schema=public"

# [OPTIONAL] Connection pool size. Keep small on serverless (each instance gets
# its own pool); a long-lived Node server can afford more. Default 10.
DATABASE_POOL_MAX=10

# [REQUIRED] Absolute public URL. Used for the CSRF Origin check, links in
# emails, and OAuth/webhook callbacks. MUST be https:// in production.
APP_URL="http://localhost:3000"

# [OPTIONAL] debug | info | warn | error. Default info.
LOG_LEVEL=debug


# =============================================================================
# SECURITY  [REQUIRED]
#
# Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# They must differ from each other (enforced in production) and must never be
# committed. Rotating SESSION_SECRET signs every user out; rotating
# ENCRYPTION_KEY makes existing TOTP secrets undecryptable, so plan that one.
# =============================================================================

# Signs and verifies session cookie integrity. Minimum 32 characters.
SESSION_SECRET="replace-this-with-48-random-bytes-base64url-encoded"

# Encrypts reversible data at rest (currently TOTP secrets) via AES-256-GCM
# with an HKDF-derived key. Minimum 32 characters.
ENCRYPTION_KEY="replace-this-with-a-different-48-random-bytes-value"

# [OPTIONAL] Idle session timeout in minutes. Default 480 (8 hours).
SESSION_IDLE_TIMEOUT_MINUTES=480

# [OPTIONAL] Hard session ceiling in hours, never extended. Default 168 (7 days).
SESSION_ABSOLUTE_TIMEOUT_HOURS=168

# [OPTIONAL] Consecutive failures before an account locks. Default 8.
LOGIN_MAX_ATTEMPTS=8

# [OPTIONAL] Lockout duration in minutes. Default 15.
LOGIN_LOCKOUT_MINUTES=15

# [OPTIONAL] Honour X-Forwarded-For / X-Real-IP. Enable ONLY behind a proxy you
# control — otherwise any client can spoof its IP and defeat rate limiting.
# Default false. Set true on Vercel, Fly, Railway, or behind your own nginx.
TRUST_PROXY=false


# =============================================================================
# STORAGE — documents, photos, exports
# =============================================================================

# [OPTIONAL] local | s3. Default local.
#   local  writes under STORAGE_LOCAL_PATH. Fine for a single server; NOT
#          suitable for serverless or multi-instance deployments, where each
#          instance would have its own disk.
#   s3     any S3-compatible service (AWS S3, MinIO, Cloudflare R2, Wasabi).
STORAGE_DRIVER=local

# [OPTIONAL] Local storage root, relative to the project. Gitignored.
STORAGE_LOCAL_PATH=".storage"

# [OPTIONAL] Maximum upload size in MB. Default 12. Keep next.config.ts's
# serverActions.bodySizeLimit at or above this.
STORAGE_MAX_UPLOAD_MB=12

# [IF STORAGE_DRIVER=s3] Bucket, region and credentials.
#   AWS:        IAM → Users → Security credentials → Create access key
#   Cloudflare: R2 → Manage R2 API Tokens
#   MinIO:      the access/secret pair from your MinIO console
# S3_BUCKET="edu-crm-documents"
# S3_REGION="eu-central-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# [OPTIONAL] Custom endpoint for a non-AWS provider. Switches to path-style
# addressing. e.g. https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT=""


# =============================================================================
# BACKGROUND JOBS & RATE LIMITING
# =============================================================================

# [OPTIONAL] database | redis. Default database.
#   database  durable with no extra infrastructure; claims work with
#             FOR UPDATE SKIP LOCKED. Correct for one or several workers.
#   redis     interface only — no Redis client is bundled. Selecting it throws.
QUEUE_DRIVER=database

# [OPTIONAL] database | memory | redis. Default database.
#   memory is per-process and therefore correct only for a single instance or
#   for tests.
RATE_LIMIT_DRIVER=database

# [IF a redis driver is selected]
# REDIS_URL="redis://localhost:6379"


# =============================================================================
# FACE RECOGNITION  (attendance)
#
# THIS SYSTEM NEVER FAKES A BIOMETRIC MATCH.
# =============================================================================

# [OPTIONAL] none | mock | aws-rekognition. Default none.
#   none             the feature reports "not configured" in the UI. Honest.
#   mock             DEVELOPMENT SIMULATOR. Performs NO recognition, reports
#                    isRealRecognition:false, and the UI labels it "Simulated".
#                    env.ts REFUSES to boot production with this value.
#   aws-rekognition  real recognition against AWS Rekognition.
FACE_RECOGNITION_PROVIDER=mock

# [OPTIONAL] Minimum match confidence in parts-per-million. 920000 = 92%.
# Below this a match is reported as LOW_CONFIDENCE and NOT recorded as
# attendance. Default 920000.
FACE_MATCH_MIN_CONFIDENCE_PPM=920000

# [IF FACE_RECOGNITION_PROVIDER=aws-rekognition]
#   Console → Rekognition. Create a collection first; IAM user needs
#   rekognition:IndexFaces, :SearchFacesByImage, :DeleteFaces.
#   Check your legal basis for biometric processing before enabling this.
# AWS_REGION="eu-central-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REKOGNITION_COLLECTION_ID="edu-crm-students"


# =============================================================================
# EMAIL
# =============================================================================

# [OPTIONAL] none | console | smtp | resend. Default none.
#   none     email notifications are SKIPPED with a recorded reason.
#   console  logs the message instead of sending. Development.
#   smtp     NOT IMPLEMENTED — nodemailer is not a dependency. Selecting this
#            throws with an explanatory error. Use resend, or add nodemailer.
#   resend   real, via the Resend HTTP API.
EMAIL_PROVIDER=console

# [IF a real provider] The From address. Must be a verified sender.
# EMAIL_FROM="Bright Future <noreply@your-domain.uz>"

# [IF EMAIL_PROVIDER=resend] resend.com → API Keys
# RESEND_API_KEY="re_..."

# [IF EMAIL_PROVIDER=smtp] (not implemented — see above)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""


# =============================================================================
# SMS
# =============================================================================

# [OPTIONAL] none | console | eskiz | playmobile | twilio. Default none.
#   eskiz / playmobile are Uzbek providers and the sensible choice for .uz
#   numbers; Twilio is expensive for Uzbekistan but useful for testing abroad.
SMS_PROVIDER=console

# [OPTIONAL] Sender name/short code, where the provider supports it.
# SMS_SENDER="4546"

# [IF SMS_PROVIDER=eskiz] my.eskiz.uz → Settings → API. Uses email+password to
# obtain a bearer token, which the driver caches and refreshes on 401.
# ESKIZ_EMAIL=""
# ESKIZ_PASSWORD=""

# [IF SMS_PROVIDER=playmobile] Credentials come from your Play Mobile contract.
# PLAYMOBILE_LOGIN=""
# PLAYMOBILE_PASSWORD=""

# [IF SMS_PROVIDER=twilio] console.twilio.com → Account Info
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""


# =============================================================================
# TELEGRAM / WHATSAPP
# =============================================================================

# [OPTIONAL] none | console | bot-api. Default none.
# Telegram can only message a chat that has already started a conversation with
# the bot, so the platform must capture each recipient's chat id first.
TELEGRAM_PROVIDER=console

# [IF TELEGRAM_PROVIDER=bot-api] Create a bot with @BotFather → /newbot
# TELEGRAM_BOT_TOKEN=""

# [OPTIONAL] none | console | cloud-api. Default none.
WHATSAPP_PROVIDER=console

# [IF WHATSAPP_PROVIDER=cloud-api] developers.facebook.com → your app →
# WhatsApp → API Setup. Template messages need prior approval from Meta.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""


# =============================================================================
# PAYMENT GATEWAY
# =============================================================================

# [OPTIONAL] manual | payme | click | stripe. Default manual.
#   manual  no gateway. Payments are recorded by an accountant. This is a fully
#           supported mode, not a placeholder — most Uzbek institutions take
#           cash and bank transfer.
PAYMENT_PROVIDER=manual

# [IF PAYMENT_PROVIDER=payme] business.payme.uz → Cabinet → your cashbox.
# The secret key verifies the JSON-RPC webhook's Basic auth header.
# PAYME_MERCHANT_ID=""
# PAYME_SECRET_KEY=""

# [IF PAYMENT_PROVIDER=click] my.click.uz → Merchant cabinet
# CLICK_MERCHANT_ID=""
# CLICK_SECRET_KEY=""

# [IF PAYMENT_PROVIDER=stripe] dashboard.stripe.com → Developers → API keys,
# and Webhooks → your endpoint → Signing secret.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."


# =============================================================================
# WORKER
# =============================================================================

# [OPTIONAL] Identifies this worker in job leases and the audit trail. Set it
# per instance when running more than one.
# WORKER_ID="worker-1"
